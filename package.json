{
  "name": "app-video",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "electron:start": "vite build && electron .",
    "electron:build": "vite build && electron-builder --win nsis",
    "icon": "node scripts/generate-icon.mjs"
  },
  "devDependencies": {
    "electron": "^32.3.3",
    "electron-builder": "^25.1.8",
    "typescript": "^5.5.4",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  },
  "dependencies": {
    "mp4box": "^2.4.1"
  },
  "build": {
    "appId": "com.ivanmv.appvideo",
    "productName": "App Video",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/*.mp4",
      "!dist/*.cube",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "App Video",
      "installerLanguages": [
        "es_ES"
      ],
      "language": "3082",
      "artifactName": "AppVideo-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    }
  },
  "description": "Editor de vídeo de escritorio (multipista, grading, exportación a MP4)",
  "author": "Iván"
}
